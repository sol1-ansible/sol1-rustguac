# Vault configuration for rustguac address book — managed by Ansible
# Minimal single-node setup with file storage

ui = true

storage "file" {
  path = "/opt/vault/data"
}

listener "tcp" {
  address     = "{{ rustguac_vault_listen_addr }}"
  tls_disable = {{ 'true' if not rustguac_vault_tls else 'false' }}
{% if rustguac_vault_tls %}
  tls_cert_file = "{{ rustguac_vault_tls_cert }}"
  tls_key_file  = "{{ rustguac_vault_tls_key }}"
{% endif %}
}

disable_mlock = true
api_addr      = "{{ rustguac_vault_local_addr }}"
