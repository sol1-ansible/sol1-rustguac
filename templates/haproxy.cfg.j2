# HAProxy configuration for rustguac — managed by Ansible
# https://github.com/sol1/rustguac/blob/main/docs/integrations.md#haproxy-reverse-proxy

global
    log /dev/log local0
    maxconn 4096
    stats socket /run/haproxy/admin.sock mode 0660 level admin
    ssl-default-bind-options no-sslv3 no-tlsv10 no-tlsv11

defaults
    log     global
    mode    http
    option  httplog
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    timeout tunnel  8h
    timeout http-request 10s

frontend https
    bind *:443 ssl crt {{ rustguac_haproxy_cert }} alpn h2,http/1.1
    bind *:80
    http-request redirect scheme https unless { ssl_fc }
    http-request del-header X-Forwarded-For
    option forwardfor
    http-response set-header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    default_backend rustguac

backend rustguac
    option httpchk GET /api/health
    server rustguac {{ rustguac_listen_addr }} ssl verify none check inter 30s
